{
  "permissions": {
    "allow": [
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(docker compose run --rm db-test*)",
      "Bash(docker compose run --rm app *)",
      "Bash(docker compose up*)",
      "Bash(curl *localhost*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git rev-parse*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Read(./.env.example)"
    ],
    "deny": [
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf *)",
      "Bash(docker compose down -v*)",
      "Bash(npx supabase db push*)",
      "Bash(npx supabase db reset --linked*)",
      "Read(./.env)",
      "Read(./.env.local)"
    ]
  }
}
