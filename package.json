{
  "name": "padel-league",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run src",
    "typecheck": "tsc -b",
    "test:rules": "firebase emulators:exec --only firestore --project demo-padel \"vitest run --config vitest.rules.config.ts\"",
    "emulators": "firebase emulators:start --only firestore,auth --project demo-padel",
    "test:cron": "firebase emulators:exec --only firestore --project demo-padel \"cd scripts && node smoke.mjs\"",
    "seed:demo": "node scripts/seed-demo.mjs"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "firebase-tools": "^14.27.0",
    "typescript": "~5.8",
    "vite": "^6.4.5",
    "vitest": "^3.2.7"
  }
}
