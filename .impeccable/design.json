      "css": ".ds-next{display:grid;gap:12px;padding:20px;border:2px solid var(--line-strong);border-radius:1.125rem;background:var(--court);color:var(--court-ink);font-family:'Atkinson Hyperlegible Next Variable',system-ui,sans-serif;text-decoration:none;cursor:pointer}.ds-next:focus-visible{outline:3px solid var(--ball);outline-offset:2px}.ds-next-when,.ds-next-teams{font-family:Anton,sans-serif;font-weight:400;text-transform:uppercase;letter-spacing:0.01em;font-variant-numeric:tabular-nums}.ds-next-when{font-size:3.25rem;line-height:0.95}.ds-next-teams{font-size:1.5rem;line-height:1.1}.ds-next-teams small{font-family:'Atkinson Hyperlegible Next Variable',sans-serif;font-size:1.0625rem;font-weight:600;text-transform:none}.ds-next-line{font-weight:700}.ds-mark{display:inline-block;background:var(--ball);color:var(--ball-ink);padding:0.04em 0.12em 0;line-height:0.96}"
