      "css": ".ds-tabbar{display:grid;grid-template-columns:repeat(3,1fr);background:oklch(0.17 0.005 80);font-family:'Atkinson Hyperlegible Next Variable',system-ui,sans-serif}.ds-tab{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;min-height:64px;font-size:0.8125rem;font-weight:600;color:oklch(0.78 0.012 85);text-decoration:none;cursor:pointer}.ds-tab:hover{color:oklch(0.97 0.01 85)}.ds-tab-pill{display:grid;place-items:center;width:48px;height:32px;border-radius:9999px}.ds-tab-active{color:var(--ball)}.ds-tab-active .ds-tab-pill{background:var(--ball);color:var(--ball-ink)}.ds-tab:focus-visible{outline:3px solid var(--ball);outline-offset:2px}"
    },
