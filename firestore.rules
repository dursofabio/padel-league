rules_version = '2';

// Piano Spark: niente Cloud Functions. I ruoli stanno in users/{uid}.role e si leggono con get().
// I controlli che richiedono di iterare (sovrapposizioni di orari) sono affidati alla transazione
// del client del gestore, che è l'utente fidato; qui si verificano identità, transizioni di stato
// e campi modificabili.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function doc(p) { return path('/databases/' + database + '/documents/' + p); }
    function role() {
      return signedIn() && exists(doc('users/' + uid()))
        ? get(doc('users/' + uid())).data.role : 'pubblico';
    }
    function isAdmin() { return role() == 'admin'; }
    function isOrg() { return role() in ['admin', 'organizzatore']; }
    function isGestore() { return role() in ['admin', 'gestore']; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function dayKey(d) { return d.replace('-', ''); }

    // ---------------------------------------------------------------- utenti
    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && uid() == userId
        && request.resource.data.role == 'giocatore';
      // il ruolo lo cambia solo l'admin
      allow update: if isAdmin()
        || (signedIn() && uid() == userId && !changed().hasAny(['role']));
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------- tornei
    match /tornei/{torneoId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isOrg();

      function partitaPath(p) { return doc('tornei/' + torneoId + '/partite/' + p); }

      match /periodi/{periodoId} {
        allow read: if true;
        allow write: if isOrg();
      }

      // Token d'invito: leggibile conoscendone l'ID (get); elencabile solo dal creatore e dall'organizzatore.
      match /inviti/{token} {
        allow get: if signedIn();
        allow list: if isOrg() || (signedIn() && resource.data.creatoDa == uid());
        allow create: if signedIn()
          && request.resource.data.creatoDa == uid()
          && getAfter(doc('tornei/' + torneoId + '/squadre/' + request.resource.data.squadraId)).data.creatoDa == uid();
        allow delete: if isOrg();
      }

      match /squadre/{squadraId} {
        allow read: if true;
        allow create: if isOrg() || (signedIn()
          && request.resource.data.creatoDa == uid()
          && request.resource.data.giocatori == [uid()]
          && request.resource.data.stato == 'in attesa partner'
          && request.resource.data.get('girone', null) == null);
        allow update: if isOrg()
          // il partner entra con il link d'invito
          || (signedIn()
            && resource.data.stato == 'in attesa partner'
            && resource.data.giocatori.size() == 1
            && !(uid() in resource.data.giocatori)
            && request.resource.data.giocatori == resource.data.giocatori.concat([uid()])
            && request.resource.data.stato == 'da approvare'
            && changed().hasOnly(['giocatori', 'stato', 'invito'])
            && get(doc('tornei/' + torneoId + '/inviti/' + request.resource.data.invito)).data.squadraId == squadraId)
          // il creatore può rinominare la coppia prima dell'approvazione
          || (signedIn() && resource.data.creatoDa == uid()
            && resource.data.stato in ['in attesa partner', 'da approvare']
            && changed().hasOnly(['nome']));
        allow delete: if isOrg()
          || (signedIn() && resource.data.creatoDa == uid() && resource.data.stato == 'in attesa partner');
      }

      match /partite/{partitaId} {
        allow read: if true;
        allow create, delete: if isOrg();
        allow update: if isOrg() || gestoreProgramma() || giocatoreProgramma() || giocatoreRisultato();

        function giocatore() { return signedIn() && uid() in resource.data.giocatori; }
        function avversari(a, b) {
          return (a in resource.data.giocatoriA && b in resource.data.giocatoriB)
            || (a in resource.data.giocatoriB && b in resource.data.giocatoriA);
        }
        function stessaCoppia(a, b) {
          return (a in resource.data.giocatoriA && b in resource.data.giocatoriA)
            || (a in resource.data.giocatoriB && b in resource.data.giocatoriB);
        }
        function richiestaVecchiaInattiva() {
          let r = get(doc('richieste/' + resource.data.richiestaId)).data;
          return r.stato != 'attesa' || r.scadenza < request.time || r.partitaId != partitaId;
        }

        function gestoreProgramma() {
          return isGestore()
            && changed().hasOnly(['stato', 'richiestaId', 'programmazione'])
            && resource.data.stato in ['da programmare', 'richiesta', 'programmata']
            && request.resource.data.stato in ['da programmare', 'richiesta', 'programmata'];
        }

        // al massimo una richiesta in attesa per partita
        function giocatoreProgramma() {
          let nuova = request.resource.data;
          return giocatore() && changed().hasOnly(['stato', 'richiestaId']) && (
            // nuova richiesta
            (nuova.stato == 'richiesta'
              && (resource.data.stato == 'da programmare'
                  || (resource.data.stato == 'richiesta' && richiestaVecchiaInattiva()))
              && getAfter(doc('richieste/' + nuova.richiestaId)).data.partitaId == partitaId
              && getAfter(doc('richieste/' + nuova.richiestaId)).data.stato == 'attesa')
            // annullamento o richiesta scaduta
            || (nuova.stato == 'da programmare' && nuova.richiestaId == null
              && resource.data.stato == 'richiesta'
              && (getAfter(doc('richieste/' + resource.data.richiestaId)).data.stato != 'attesa'
                  || richiestaVecchiaInattiva()))
          );
        }

        function giocatoreRisultato() {
          let r = request.resource.data.risultato;
          let old = resource.data.get('risultato', null);
          return giocatore() && (
            // inserimento (o correzione dalla stessa coppia, prima della conferma)
            (changed().hasOnly(['risultato'])
              && resource.data.stato in ['da programmare', 'richiesta', 'programmata']
              && r.inseritoDa == uid()
              && r.get('confermatoDa', null) == null
              && r.get('contestatoDa', null) == null
              && r.set is list && r.set.size() >= 1 && r.set.size() <= 5
              && (old == null || stessaCoppia(uid(), old.inseritoDa)))
            // conferma da un giocatore della coppia avversaria
            || (changed().hasOnly(['risultato', 'stato'])
              && old != null && old.get('confermatoDa', null) == null
              && resource.data.stato in ['da programmare', 'richiesta', 'programmata']
              && request.resource.data.stato == 'giocata'
              && r.diff(old).affectedKeys().hasOnly(['confermatoDa'])
              && r.confermatoDa == uid()
              && avversari(uid(), old.inseritoDa))
            // contestazione: decide l'organizzatore
            || (changed().hasOnly(['risultato', 'stato'])
              && old != null && old.get('confermatoDa', null) == null
              && resource.data.stato in ['da programmare', 'richiesta', 'programmata']
              && request.resource.data.stato == 'contestata'
              && r.diff(old).affectedKeys().hasOnly(['contestatoDa', 'nota'])
              && r.contestatoDa == uid()
              && avversari(uid(), old.inseritoDa))
          );
        }
      }
    }

    // ---------------------------------------------------------------- campi e occupazioni
    match /campi/{campoId} {
      allow read: if true;
      allow write: if isGestore();
    }
    match /ricorrenze/{id} {
      allow read: if signedIn();
      allow write: if isGestore();
    }
    match /occupazioni/{id} {
      allow read: if signedIn();
      allow write: if isGestore();
    }

    // ---------------------------------------------------------------- disponibilità
    match /disponibilita/{id} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.uid == uid()
        && id == request.resource.data.torneoId + '_' + uid();
      allow delete: if signedIn() && resource.data.uid == uid();
    }

    // ---------------------------------------------------------------- richieste
    // ID deterministico {campoId}_{yyyymmdd}_{hhmm}: fa da lock sullo slot.
    match /richieste/{rid} {
      allow read: if signedIn();

      function nuovaValida() {
        let d = request.resource.data;
        let pPath = doc('tornei/' + d.torneoId + '/partite/' + d.partitaId);
        let p = get(pPath).data;
        let t = get(doc('tornei/' + d.torneoId)).data;
        return d.stato == 'attesa'
          && d.creatoDa == uid()
          && rid == d.campoId + '_' + dayKey(d.data) + '_' + d.inizio.replace(':', '')
          && d.giocatori == p.giocatori
          && d.accettazioni.keys().hasOnly(p.giocatori)
          && (uid() in p.giocatori || isGestore())
          && (d.fuoriGriglia == false || t.config.consentiFuoriGriglia == true)
          && d.scadenza > request.time
          && d.scadenza < request.time + duration.value(30, 'd')
          && getAfter(pPath).data.richiestaId == rid;
      }

      allow create: if signedIn() && nuovaValida();

      allow update: if signedIn() && (
        // sovrascrittura di uno slot liberato, o di una richiesta scaduta (scadenza "pigra")
        ((resource.data.stato in ['rifiutata', 'annullata', 'scaduta', 'conflitto']
            || (resource.data.stato == 'attesa' && resource.data.scadenza < request.time))
          && nuovaValida())
        // accettazione: ogni giocatore aggiunge solo la propria chiave
        || (resource.data.stato == 'attesa' && uid() in resource.data.giocatori
          && changed().hasOnly(['accettazioni'])
          && request.resource.data.accettazioni.diff(resource.data.accettazioni).affectedKeys().hasOnly([uid()])
          && request.resource.data.accettazioni[uid()] == request.time)
        // annullamento da uno dei giocatori, finché non è confermata
        || (resource.data.stato == 'attesa' && uid() in resource.data.giocatori
          && changed().hasOnly(['stato', 'nota'])
          && request.resource.data.stato == 'annullata')
        // gestore
        || (isGestore() && changed().hasOnly(['stato', 'nota', 'gestitoDa']) && (
          (resource.data.stato == 'attesa' && request.resource.data.stato in ['rifiutata', 'conflitto', 'scaduta'])
          || (resource.data.stato == 'attesa' && request.resource.data.stato == 'confermata'
            && request.resource.data.accettazioni.keys().hasAll(resource.data.giocatori)
            && rid in getAfter(doc('occupazioni/' + resource.data.campoId + '_' + dayKey(resource.data.data))).data.items)
          || (resource.data.stato == 'confermata' && request.resource.data.stato == 'annullata')
        ))
      );
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------- log
    match /log/{id} {
      allow read: if isOrg();
      allow create: if signedIn() && request.resource.data.chi == uid();
    }
  }
}
