# Configurazione Firebase (pubblica: la sicurezza dipende dalle Security Rules)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# Chiave del sito reCAPTCHA v3 per App Check (consigliata in produzione)
VITE_APPCHECK_SITE_KEY=
# Sviluppo locale con gli emulatori Firebase (npm run emulators)
VITE_USE_EMULATORS=
